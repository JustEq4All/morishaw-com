---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Gilberto Morishaw — Speaker, Systems Consultant, and Convenor. From Curaçao to the rooms where the future gets decided.",
  ogImage = "/images/og-default.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- JSON-LD: Person (Knowledge Panel optimized) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Gilberto Morishaw",
    "alternateName": ["Gilberto Anthony Morishaw", "Gilbert Morishaw"],
    "url": "https://morishaw.com",
    "image": "https://morishaw.com/images/gilberto-morishaw.png",
    "sameAs": [
      "https://www.wikidata.org/wiki/Q141249578",
      "https://www.linkedin.com/in/gilbertomorishaw",
      "https://www.weforum.org/stories/authors/gilberto-morishaw",
      "https://www.speakersacademy.com/nl/spreker/gilberto-morishaw/",
      "https://www.instagram.com/bertmangil",
      "https://github.com/gilbertomorishaw",
      "https://www.youtube.com/@gilbertomorishaw"
    ],
    "jobTitle": "Policy Advisor and Innovator",
    "worksFor": {
      "@type": "Organization",
      "name": "Creative Regenerative Futures Foundation",
      "url": "https://morishaw.com"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Leiden University",
      "sameAs": "https://www.wikidata.org/wiki/Q156598"
    },
    "birthPlace": {
      "@type": "Place",
      "name": "Curaçao"
    },
    "nationality": {
      "@type": "Country",
      "name": "Kingdom of the Netherlands"
    },
    "award": [
      "Worldwide Innovation Prize, Global Shapers Community, World Economic Forum",
      "Davos50 Fellow, World Economic Forum",
      "Humanity in Action Fellowship"
    ],
    "knowsAbout": [
      "Sustainability",
      "Climate justice",
      "Regenerative economies",
      "Social impact",
      "Governance",
      "Technology for good",
      "Artificial intelligence",
      "Migration",
      "Web3",
      "Youth engagement",
      "Systems thinking"
    ],
    "description": "Dutch Caribbean systems transformation consultant, speaker, and convenor working at the intersection of sustainability, society, and technology. Based in The Hague."
  }
  </script>
</head>
<body>
  <slot name="nav" />
  <main>
    <slot />
  </main>
  <slot name="footer" />

  <script>
    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>
